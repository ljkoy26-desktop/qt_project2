#include "../../../include/VersionNo.h"

#ifndef _MAC
/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FILEVERSION_VALUE
 PRODUCTVERSION PRODUCTVERSION_VALUE
